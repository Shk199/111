diff --git a/app/src/main/java/com/example/bubble/SmartTasbeehManager.kt b/app/src/main/java/com/example/bubble/SmartTasbeehManager.kt
index 94574a7..40ae6f6 100644
--- a/app/src/main/java/com/example/bubble/SmartTasbeehManager.kt
+++ b/app/src/main/java/com/example/bubble/SmartTasbeehManager.kt
@@ -119,10 +119,10 @@ object SmartTasbeehManager {
     fun startBubbleService(context: Context) {
         if (!canDrawOverlays(context)) return
         val intent = Intent(context, TasbihBubbleService::class.java)
-        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
-            ContextCompat.startForegroundService(context, intent)
-        } else {
+        try {
             context.startService(intent)
+        } catch (e: Exception) {
+            e.printStackTrace()
         }
     }
 
diff --git a/app/src/main/java/com/example/bubble/TasbihBubbleService.kt b/app/src/main/java/com/example/bubble/TasbihBubbleService.kt
index 74f1350..18eab75 100644
--- a/app/src/main/java/com/example/bubble/TasbihBubbleService.kt
+++ b/app/src/main/java/com/example/bubble/TasbihBubbleService.kt
@@ -6,7 +6,6 @@ import android.app.PendingIntent
 import android.app.Service
 import android.content.Context
 import android.content.Intent
-import android.content.pm.ServiceInfo
 import android.graphics.Color
 import android.graphics.PixelFormat
 import android.graphics.Typeface
@@ -67,7 +66,7 @@ class TasbihBubbleService : Service() {
         val dao = TasbeehDatabase.getInstance(applicationContext).tasbeehDao()
         repository = TasbeehRepository(dao)
 
-        startForegroundNotification()
+        showBubbleNotification()
         initFloatingBubble()
         observeAzkarData()
     }
@@ -81,7 +80,7 @@ class TasbihBubbleService : Service() {
         return START_STICKY
     }
 
-    private fun startForegroundNotification() {
+    private fun showBubbleNotification() {
         if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
             val channel = NotificationChannel(
                 CHANNEL_ID,
@@ -125,14 +124,11 @@ class TasbihBubbleService : Service() {
             .setPriority(NotificationCompat.PRIORITY_LOW)
             .build()
 
-        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE) {
-            startForeground(
-                NOTIFICATION_ID,
-                notification,
-                ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE
-            )
-        } else {
-            startForeground(NOTIFICATION_ID, notification)
+        try {
+            val manager = getSystemService(NotificationManager::class.java)
+            manager?.notify(NOTIFICATION_ID, notification)
+        } catch (e: Exception) {
+            e.printStackTrace()
         }
     }
 
@@ -449,6 +445,12 @@ class TasbihBubbleService : Service() {
             }
         }
         floatingView = null
+        try {
+            val manager = getSystemService(NotificationManager::class.java)
+            manager?.cancel(NOTIFICATION_ID)
+        } catch (e: Exception) {
+            e.printStackTrace()
+        }
         SmartTasbeehManager.setEnabled(this, false)
     }
 }
